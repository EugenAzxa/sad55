# Сайт открывается и по http, и по https. Для поисковика это два разных
# сайта с одинаковым содержимым, и вес страниц делится между ними пополам.
# Отправляем всех на https.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.sad56.spb.ru - тот же сайт под вторым написанием. Всех, кто зашёл
  # с www, сразу отправляем на основной адрес, чтобы у поисковика был один.
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://sad56.spb.ru%{REQUEST_URI} [L,R=301]
  # Перед Apache стоит nginx, и он разбирает TLS сам. Поэтому %{HTTPS} тут
  # бывает пустым даже на защищённом соединении, а настоящий протокол
  # приезжает в заголовке. Проверяем оба: редирект только если ОБА говорят,
  # что соединение открытое. Иначе получилась бы вечная петля.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # /index.html и / это одна страница: оставляем у поисковика один адрес.
  # Проверяем саму строку запроса браузера (THE_REQUEST), а не путь после
  # подстановки DirectoryIndex, иначе / -> index.html -> / закрутилось бы в петлю.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://sad56.spb.ru/ [L,R=301]
  # Снятые статьи: 410 Gone, чтобы поисковики быстрее убрали их из выдачи.
  # Центр не лечит несовершеннолетних (31.10), статья о подростках удалена.
  RewriteRule ^blog/alkogolizm-u-podrostkov\.html$ - [G,L]
</IfModule>

# Стили и скрипты меняются под тем же именем. Без этого браузер сам решал,
# сколько держать старую копию, и новая разметка встречалась со старыми
# стилями. no-cache = хранить можно, но перед показом сверить с сервером
# (это короткий ответ 304, если файл не менялся).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Картинки, видео и шрифты под одним именем не меняются (новая версия
  # получает новое имя или ?v=), поэтому браузер может держать их 30 дней.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|mp4|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
